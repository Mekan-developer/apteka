# Шаблон .env для Docker. Скопируй в корень проекта как .env
# Отличия от .env.example помечены  # DOCKER

APP_NAME=Admika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# DOCKER: логи в stderr контейнера → docker compose logs app
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# DOCKER: хост = имя сервиса из docker-compose.yml, не 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
# DOCKER: порт внутри docker-сети. С хоста база доступна на 127.0.0.1:5433
DB_PORT=5432
DB_DATABASE=admika
DB_USERNAME=admika
DB_PASSWORD=secret

# DOCKER: сессии, кэш и очередь — в Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# DOCKER: null = Redis без пароля, иначе контейнер запускается с этим паролем
REDIS_PASSWORD=null
REDIS_PORT=6379

# DOCKER: письма ловит Mailpit → http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

IMAGES_DISK=public
IMAGES_TEMPORARY_DISK=local
IMAGES_WEBP_QUALITY=80

VITE_APP_NAME="${APP_NAME}"

# DOCKER: UID/GID пользователя хоста (на Windows можно оставить 1000)
UID=1000
GID=1000

# DOCKER: зеркала пакетов для сборки образа. Пусто = качать напрямую из интернета
PACKAGIST_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
DEBIAN_MIRROR=https://nexus.telecom.tm/repository/debian-proxy
DEBIAN_SECURITY_MIRROR=https://nexus.telecom.tm/repository/debian-security
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/

# DOCKER: только для prod (docker-compose.prod.yml) — порт nginx на сервере
NGINX_PORT=80
