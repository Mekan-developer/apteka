# ==========================================
# APPLICATION — Основные настройки приложения
# ==========================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Язык приложения
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

# Режим обслуживания
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


# ==========================================
# SECURITY — Безопасность
# ==========================================
# Количество раундов хеширования паролей
BCRYPT_ROUNDS=12


# ==========================================
# LOGGING — Логирование
# ==========================================

# Канал логирования и способ хранения логов
LOG_CHANNEL=stack
LOG_STACK=daily

# Уровень логирования: debug, info, notice, warning, error
LOG_LEVEL=debug

# Канал логирования предупреждений об устаревших функциях
LOG_DEPRECATIONS_CHANNEL=null

# Сколько дней хранить ежедневные логи
LOG_DAILY_DAYS=14


# ==========================================
# DATABASE — Подключение к PostgreSQL
# ==========================================

DB_CONNECTION=pgsql
DB_HOST=postgres
# Порт внутри docker-сети. Снаружи (с хоста) база доступна на 127.0.0.1:5433.
DB_PORT=5432
DB_DATABASE=apteka
DB_USERNAME=apteka
DB_PASSWORD=secret

# ВАЖНО:
# Если Laravel работает внутри Docker, DB_HOST должен совпадать
# с именем сервиса PostgreSQL в docker-compose.yml,
# а DB_PORT должен быть внутренним портом PostgreSQL: 5432.
# Тесты используют отдельную базу "testing" (см. phpunit.xml).


# ==========================================
# SESSION — Пользовательские сессии
# ==========================================

# Хранилище сессий: redis, database, file и другие
SESSION_DRIVER=redis

# Время жизни сессии в минутах
SESSION_LIFETIME=120

# Шифрование данных сессии
SESSION_ENCRYPT=false

# Путь и домен действия cookie
SESSION_PATH=/
SESSION_DOMAIN=null


# ==========================================
# CACHE — Кэширование
# ==========================================

# Хранилище кэша
CACHE_STORE=redis


# ==========================================
# QUEUE — Очереди задач
# ==========================================

# Драйвер очередей
QUEUE_CONNECTION=redis


# ==========================================
# REDIS — Кэш, сессии и очереди
# ==========================================

# Клиент Redis для PHP
REDIS_CLIENT=phpredis

# Имя сервиса Redis внутри Docker
REDIS_HOST=redis

# Пароль Redis (null — без пароля)
REDIS_PASSWORD=null

# Порт Redis внутри Docker
REDIS_PORT=6379


# ==========================================
# BROADCASTING — Трансляция событий
# ==========================================

# log — записывать события в логи
BROADCAST_CONNECTION=log


# ==========================================
# FILE STORAGE — Хранение файлов
# ==========================================

# Основное хранилище файлов
FILESYSTEM_DISK=local

# Диск для изображений
IMAGES_DISK=public

# Временное хранилище изображений
IMAGES_TEMPORARY_DISK=local

# Качество WebP-изображений (0–100)
IMAGES_WEBP_QUALITY=80


# ==========================================
# MAIL — Отправка электронной почты
# ==========================================

# SMTP-настройки Mailpit для локальной разработки
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025

# Авторизация SMTP не требуется
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Адрес и имя отправителя
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Интерфейс Mailpit:
# http://localhost:8025


# ==========================================
# VITE — Frontend
# ==========================================

# Имя приложения для Vite
VITE_APP_NAME="${APP_NAME}"


# ==========================================
# DOCKER — Права доступа к файлам
# ==========================================

# UID/GID пользователя для корректных прав доступа
# В Windows можно оставить значения по умолчанию.
UID=1000
GID=1000

PACKAGIST_MIRROR=https://nexus.telecom.tm/repository/composer-proxy/
DEBIAN_MIRROR=https://nexus.telecom.tm/repository/debian-proxy
DEBIAN_SECURITY_MIRROR=https://nexus.telecom.tm/repository/debian-security
NPM_REGISTRY=https://nexus.telecom.tm/repository/npm-proxy/